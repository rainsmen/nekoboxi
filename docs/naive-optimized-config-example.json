{
  "outbounds": [
    {
      "type": "naive",
      "tag": "proxy",
      "server": "your-server.com",
      "server_port": 443,
      "username": "your-username",
      "password": "your-password",
      "tls": {
        "enabled": true,
        "server_name": "your-server.com"
      },
      "connection_warmup": true,
      "insecure_concurrency": 4,
      "quic": true,
      "quic_congestion_control": "bbr"
    }
  ]
}
