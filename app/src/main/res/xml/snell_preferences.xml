<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="name"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="serverAddress"
            app:title="@string/server_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_maps_directions_boat"
            app:key="serverPort"
            app:title="@string/server_port"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="4"
            app:entries="@array/snell_version"
            app:entryValues="@array/snell_version"
            app:icon="@drawable/ic_baseline_update_24"
            app:key="version"
            app:title="@string/protocol_version"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_settings_password"
            app:key="psk"
            app:title="PSK" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_settings_password"
            app:key="userKey"
            app:title="@string/snell_user_key" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="reuse"
            app:summary="@string/snell_reuse_summary"
            app:title="@string/snell_reuse" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/obfs">
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue=""
            app:entries="@array/snell_obfs_mode"
            app:entryValues="@array/snell_obfs_mode_value"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="obfsMode"
            app:title="@string/obfs"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="obfsHost"
            app:title="@string/snell_obfs_host"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue=""
            app:entries="@array/snell_mode"
            app:entryValues="@array/snell_mode_value"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="mode"
            app:title="@string/snell_mode"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>
